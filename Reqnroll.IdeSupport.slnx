        <!-- Not built directly for Debug: Reqnroll.IdeSupport.LSP.Server's BuildConnector target
             already builds this project (with different global properties) as part of its own
             Build. Building it a second time here as an independent solution node races the first
             build's CustomAfterBuild target (RemoveDir + Copy into the same Connectors\ output
             folder), causing an intermittent MSB3231 "directory not empty" failure under VS's
             parallel project builds. Release keeps it listed for CI/VSIX packaging consistency. -->
        <Project Path="src/LSP/Reqnroll.IdeSupport.LSP.Connector/Connector/Connector.csproj" Id="98b8a6cc-4a40-4603-a6dc-8c5edd408e4b">
