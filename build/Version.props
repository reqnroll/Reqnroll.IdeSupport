<Project>
  <PropertyGroup>
	<!-- Main version shared by every asset built in this repo (LSP server, Visual Studio, VS Code, Rider): hand-bumped for meaningful milestones. -->
	<ReqnrollIdeSupportMainVersion>2026.1</ReqnrollIdeSupportMainVersion>
	<!-- Build number: CI overrides this with the run number (-p:ReqnrollIdeSupportBuildNumber=...);
	     locally it defaults high so a local build always sorts newer than any CI build. -->
	<ReqnrollIdeSupportBuildNumber Condition="'$(ReqnrollIdeSupportBuildNumber)' == ''">99999</ReqnrollIdeSupportBuildNumber>
	<VersionPrefix>$(ReqnrollIdeSupportMainVersion).$(ReqnrollIdeSupportBuildNumber)</VersionPrefix>
	<VersionSuffix>alpha</VersionSuffix>
	<!-- AssemblyVersion/AssemblyFileVersion each require components <= ushort.MaxValue, which
	     ReqnrollIdeSupportBuildNumber (a CI run number) can exceed. Pin them to the main version only, same
	     as Reqnroll.VisualStudio's Directory.Build.props — the build number still flows into
	     AssemblyInformationalVersion (a free-form string) via VersionPrefix/VersionSuffix above. -->
	<AssemblyVersion>$(ReqnrollIdeSupportMainVersion).0.0</AssemblyVersion>
  </PropertyGroup>
</Project>
