<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Reqnroll.IdeSupport.Rider.Backend</AssemblyName>
    <RootNamespace>Reqnroll.IdeSupport.Rider.Backend</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Rider's own test results reach the LSP server over the protocol the VSTest logger and the MTP reporter
       use (TestReporter.Common), and find the server the way the MTP reporter does (the TestReporter.Session
       shared project). The plugin's Gradle build ships TestReporter.Common.dll next to this assembly. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Reqnroll.IdeSupport.TestReporter.Common\Reqnroll.IdeSupport.TestReporter.Common.csproj" />
  </ItemGroup>
  <Import Project="..\..\..\Core\Reqnroll.IdeSupport.TestReporter.Session\Reqnroll.IdeSupport.TestReporter.Session.projitems" Label="Shared" />
  <ItemGroup>
    <PackageReference Include="JetBrains.Rider.SDK" Version="$(RiderSdkVersion)" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <!-- Returns the resolved JetBrains.ReSharper.UnitTestFramework.dll of the Rider SDK this module builds against.
       The backend tests read it to check the internal type FeatureTestGutterStage creates by reflection
       (UnitTestHighlightingContract). -->
  <Target Name="GetRiderUnitTestFrameworkReference" DependsOnTargets="ResolveAssemblyReferences" Returns="@(_RiderUnitTestFrameworkReference)">
    <ItemGroup>
      <_RiderUnitTestFrameworkReference Include="@(ReferencePath)" Condition="'%(Filename)' == 'JetBrains.ReSharper.UnitTestFramework'" />
    </ItemGroup>
  </Target>
</Project>
