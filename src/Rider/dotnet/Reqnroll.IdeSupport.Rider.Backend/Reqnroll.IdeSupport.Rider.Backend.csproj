<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Reqnroll.IdeSupport.Rider.Backend</AssemblyName>
    <RootNamespace>Reqnroll.IdeSupport.Rider.Backend</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared with the VSTest logger and the MTP reporter, so Rider's own test results reach the LSP server
         over the same protocol and find it the same way. -->
    <Compile Include="..\..\..\Core\Reqnroll.IdeSupport.TestReporter.Common\NdjsonWriter.cs" Link="Shared\NdjsonWriter.cs" />
    <Compile Include="..\..\..\Core\Reqnroll.IdeSupport.TestReporter.Common\OutcomeSink.cs" Link="Shared\OutcomeSink.cs" />
    <Compile Include="..\..\..\Core\Reqnroll.IdeSupport.TestReporter.MTP\SessionBreadcrumbMatcher.cs" Link="Shared\SessionBreadcrumbMatcher.cs" />
    <Compile Include="..\..\..\Core\Reqnroll.IdeSupport.TestReporter.MTP\SessionsDirectory.cs" Link="Shared\SessionsDirectory.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="JetBrains.Rider.SDK" Version="$(RiderSdkVersion)" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
</Project>
