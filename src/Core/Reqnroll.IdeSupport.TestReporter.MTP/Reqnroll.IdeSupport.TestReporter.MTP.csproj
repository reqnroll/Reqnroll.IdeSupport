<Project Sdk="Microsoft.NET.Sdk">

  <!-- Microsoft.Testing.Platform (MTP) in-process reporter — issue #715 phase 2. Composite extension
       (ITestSessionLifetimeHandler + IDataConsumer) that streams the same NDJSON-over-TCP protocol the
       VSTest logger (Reqnroll.IdeSupport.TestLogger) already speaks, to the same LSP-server listener,
       so MTP-mode Reqnroll test projects get the same live per-row outcome pipeline. See
       docs/MTP-Test-Outcomes-Implementation-Plan.md §4-§5.

       Loads inside the MTP test host process, which already provides Microsoft.Testing.Platform.dll —
       ExcludeAssets="runtime" on that PackageReference keeps our own build output free of it, mirroring
       Reqnroll.IdeSupport.TestLogger's Microsoft.TestPlatform.ObjectModel reference. net8.0 (not
       netstandard2.0): MTP v2's minimum supported runtime, and this assembly never loads into a net48
       process the way the VSTest logger does. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Reqnroll.IdeSupport.TestReporter.MTP</RootNamespace>
    <AssemblyName>Reqnroll.IdeSupport.TestReporter.MTP</AssemblyName>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\reqnroll.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to what MSTest.TestAdapter 4.2.3 (the fixture's own MTP runner) itself depends on, so a
         test project referencing both this assembly and MSTest doesn't hit an unresolvable assembly
         version conflict (MSB3277) between two different Microsoft.Testing.Platform versions. -->
    <PackageReference Include="Microsoft.Testing.Platform" Version="2.2.3" ExcludeAssets="runtime" PrivateAssets="all" />
    <ProjectReference Include="..\Reqnroll.IdeSupport.TestReporter.Common\Reqnroll.IdeSupport.TestReporter.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Reqnroll.IdeSupport.TestReporter.MTP.Tests, </_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
