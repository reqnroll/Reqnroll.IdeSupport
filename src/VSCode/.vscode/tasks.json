{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"],
      "label": "npm: compile",
      "detail": "tsc -p ./tsconfig.json"
    },
    {
      "type": "npm",
      "script": "build:server:dev",
      "problemMatcher": [],
      "label": "npm: build:server:dev",
      "detail": "Republish the LSP server for F5 dev-mode if source has changed (see issue #44)"
    },
    {
      "type": "npm",
      "script": "build:testlogger:dev",
      "problemMatcher": [],
      "label": "npm: build:testlogger:dev",
      "detail": "Republish the bundled TestLogger for F5 dev-mode if source has changed (LSP-server outcome pipeline, #700/#702)"
    },
    {
      "type": "npm",
      "script": "build:mtpreporter:dev",
      "problemMatcher": [],
      "label": "npm: build:mtpreporter:dev",
      "detail": "Republish the bundled TestReporter.MTP for F5 dev-mode if source has changed (LSP-server outcome pipeline, issue #715 phase 4)"
    },
    {
      "label": "Run Extension: prelaunch",
      "dependsOrder": "sequence",
      "dependsOn": [
        "npm: build:server:dev",
        "npm: build:testlogger:dev",
        "npm: build:mtpreporter:dev",
        "npm: compile"
      ]
    },
    {
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "group": "build",
      "problemMatcher": ["$tsc-watch"],
      "label": "npm: watch",
      "detail": "tsc -watch -p ./tsconfig.json"
    },
    {
      "type": "npm",
      "script": "lint",
      "group": "build",
      "problemMatcher": ["$eslint-stylish"],
      "label": "npm: lint",
      "detail": "eslint src --ext .ts"
    }
  ]
}
