{
  "name": "reqnroll-ide-support",
  "displayName": "Reqnroll Extension for VS Code (Preview)",
  "description": "[Preview] Support for Reqnroll & Gherkin — syntax highlighting, navigation, completion, and more.",
  "version": "0.1.0",
  "publisher": "Reqnroll",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#c4d600",
    "theme": "light"
  },
  "homepage": "https://reqnroll.net",
  "bugs": {
    "url": "https://github.com/reqnroll/Reqnroll.IdeSupport/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Testing",
    "Formatters",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "gherkin",
    "cucumber",
    "specflow",
    "reqnroll",
    "bdd",
    "feature"
  ],
  "activationEvents": [
    "onLanguage:plaintext",
    "workspaceContains:**/*.feature"
  ],
  "contributes": {
    "languages": [
      {
        "id": "gherkin",
        "aliases": [
          "Gherkin",
          "Feature",
          "SpecFlow",
          "Reqnroll"
        ],
        "extensions": [
          ".feature"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gherkin",
        "scopeName": "text.gherkin.feature",
        "path": "./syntaxes/gherkin.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "reqnroll.toggleComment",
        "title": "Reqnroll: Comment/Uncomment"
      },
      {
        "command": "reqnroll.findStepUsages",
        "title": "Reqnroll: Find Step Usages"
      },
      {
        "command": "reqnroll.findUnusedStepDefinitions",
        "title": "Reqnroll: Find Unused Step Definitions"
      },
      {
        "command": "reqnroll.goToHooks",
        "title": "Reqnroll: Go to Hooks"
      },
      {
        "command": "reqnroll.openTagLink",
        "title": "Reqnroll: Open Tag Link"
      },
      {
        "command": "reqnroll.showOutputChannel",
        "title": "Reqnroll: Show Output Channel"
      },
      {
        "command": "reqnroll.goToStepDefinition",
        "title": "Reqnroll: Go to Step Definition"
      },
      {
        "command": "reqnroll.defineSteps",
        "title": "Reqnroll: Define Steps"
      },
      {
        "command": "reqnroll.renameStep",
        "title": "Reqnroll: Rename Step"
      },
      {
        "command": "reqnroll.renameStepOrSymbol",
        "title": "Reqnroll: Rename Step or Symbol"
      }
    ],
    "keybindings": [
      {
        "key": "ctrl+/",
        "mac": "cmd+/",
        "command": "reqnroll.toggleComment",
        "when": "editorTextFocus && editorLangId == gherkin"
      },
      {
        "key": "f12",
        "command": "reqnroll.goToStepDefinition",
        "when": "editorTextFocus && editorLangId == gherkin"
      },
      {
        "key": "f2",
        "command": "reqnroll.renameStepOrSymbol",
        "when": "editorTextFocus && (editorLangId == gherkin || editorLangId == csharp)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "reqnroll.toggleComment",
          "when": "editorLangId == gherkin",
          "group": "1_modification"
        },
        {
          "command": "reqnroll.goToHooks",
          "when": "editorLangId == gherkin",
          "group": "navigation@90"
        },
        {
          "command": "reqnroll.findStepUsages",
          "when": "editorLangId == csharp",
          "group": "navigation@90"
        },
        {
          "command": "reqnroll.defineSteps",
          "when": "editorLangId == gherkin",
          "group": "1_modification@10"
        },
        {
          "command": "reqnroll.renameStep",
          "when": "editorLangId == gherkin || editorLangId == csharp",
          "group": "1_modification@20"
        }
      ],
      "commandPalette": [
        {
          "command": "reqnroll.toggleComment",
          "when": "editorLangId == gherkin"
        },
        {
          "command": "reqnroll.goToHooks",
          "when": "editorLangId == gherkin"
        },
        {
          "command": "reqnroll.findStepUsages",
          "when": "editorLangId == csharp"
        },
        {
          "command": "reqnroll.openTagLink",
          "when": "false"
        },
        {
          "command": "reqnroll.goToStepDefinition",
          "when": "false"
        },
        {
          "command": "reqnroll.defineSteps",
          "when": "editorLangId == gherkin"
        },
        {
          "command": "reqnroll.renameStep",
          "when": "editorLangId == gherkin || editorLangId == csharp"
        },
        {
          "command": "reqnroll.renameStepOrSymbol",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Reqnroll",
      "properties": {
        "reqnroll.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Turns on troubleshooting output for the Reqnroll extension and its language server. Use \"messages\" or \"verbose\" when you are asked for logs to report a problem; \"verbose\" also saves a log file to the Reqnroll log folder. Reload the window after changing it."
        },
        "reqnroll.protocolLogLevel": {
          "type": "string",
          "enum": [
            "Off",
            "Error",
            "Warning",
            "Info",
            "Verbose"
          ],
          "default": "Warning",
          "description": "How much low-level technical detail the Reqnroll language server writes to its protocol log. Leave it at Warning unless you are asked for more detail when reporting a problem. Reload the window after changing it."
        },
        "reqnroll.testOutcomes.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show the result of each example of a Scenario Outline, and the details of the failed step, after you run tests with C# Dev Kit. When turned on, Reqnroll adds its test logger to the runsettings file that C# Dev Kit uses (the dotnet.unitTests.runSettingsPath setting); your existing runsettings content is kept. Off by default because it changes that setting. Reload the window after changing it."
        }
      }
    },
    "configurationDefaults": {
      "[gherkin]": {
        "editor.defaultFormatter": "Reqnroll.reqnroll-ide-support",
        "editor.formatOnType": true
      }
    },
    "semanticTokenScopes": [
      {
        "language": "gherkin",
        "scopes": {
          "reqnroll.keyword": [
            "keyword.control.gherkin"
          ],
          "reqnroll.tag": [
            "entity.name.tag.gherkin"
          ],
          "reqnroll.description": [
            "markup.raw.gherkin"
          ],
          "reqnroll.comment": [
            "comment.line.gherkin"
          ],
          "reqnroll.doc_string": [
            "string.quoted.other.gherkin"
          ],
          "reqnroll.data_table": [
            "markup.table.gherkin"
          ],
          "reqnroll.data_table_header": [
            "markup.table.header.gherkin"
          ],
          "reqnroll.step_parameter": [
            "variable.parameter.gherkin"
          ],
          "reqnroll.scenario_outline_placeholder": [
            "variable.other.placeholder.gherkin"
          ],
          "reqnroll.undefined_step": [
            "invalid.deprecated.gherkin"
          ],
          "reqnroll.ambiguous_step": [
            "markup.raw.ambiguous.gherkin"
          ]
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "reqnroll.getStarted",
        "title": "Get Started with Reqnroll",
        "description": "Welcome to Reqnroll for VS Code — write BDD tests in plain language. This page links to the full end-user documentation.",
        "steps": [
          {
            "id": "welcome",
            "title": "Welcome to Reqnroll",
            "description": "Reqnroll brings Gherkin / BDD support to VS Code. This page points you to the full documentation on the Reqnroll website.",
            "media": {
              "markdown": "media/walkthroughs/welcome.md"
            }
          }
        ]
      }
    ]
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "node scripts/copy-changelog.mjs && npm run compile && npm run bundle",
    "compile": "tsc -p ./tsconfig.json",
    "bundle": "node scripts/esbuild.mjs",
    "watch": "tsc -watch -p ./tsconfig.json",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "build:server": "bash scripts/publish-server.sh",
    "build:server:dev": "node scripts/dev-publish-server.mjs",
    "build:testlogger": "bash scripts/publish-testlogger.sh",
    "build:testlogger:dev": "node scripts/dev-publish-testlogger.mjs",
    "build:mtpreporter": "bash scripts/publish-mtpreporter.sh",
    "build:mtpreporter:dev": "node scripts/dev-publish-mtpreporter.mjs",
    "build:vsix": "bash scripts/build-vsix.sh",
    "validate:tokens": "node scripts/validate-semantic-token-scopes.mjs",
    "prepare": "cd ../.. && node src/VSCode/node_modules/husky/bin.js"
  },
  "lint-staged": {
    "*.ts": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.0",
    "@types/node": "^26.6.4",
    "@types/vscode": "~1.96.0",
    "@types/xml2js": "^0.4.14",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reqnroll/Reqnroll.IdeSupport.git"
  },
  "dependencies": {
    "@vscode/extension-telemetry": "^1.5.2",
    "vscode-languageclient": "^10.1.2",
    "xml2js": "^0.6.2"
  }
}
