<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>annotations</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\reqnroll.snk</AssemblyOriginatorKeyFile>
    <NoWarn>CS0067;VSTHRD200;MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GitHubActionsTestLogger" Version="2.4.1" Condition="'$(REQNROLL_TEST_PIPELINEMODE)' == 'true'">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
    <PackageReference Include="System.IO.Abstractions.TestingHelpers" Version="22.1.1" />
    <PackageReference Include="NSubstitute " Version="5.3.0" />
    <PackageReference Include="AwesomeAssertions" Version="9.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Core/Reqnroll.IdeSupport.Common/Reqnroll.IdeSupport.Common.csproj" />
    <ProjectReference Include="../../../src/VisualStudio/Reqnroll.IdeSupport.VisualStudio.VSSDKIntegration/Reqnroll.IdeSupport.VisualStudio.VSSDKIntegration.csproj" />
    <ProjectReference Include="../../../src/VisualStudio/Reqnroll.IdeSupport.VisualStudio.Extension/Reqnroll.IdeSupport.VisualStudio.Extension.csproj" />
    <ProjectReference Include="../../../src/LSP/Reqnroll.IdeSupport.LSP.Core/Reqnroll.IdeSupport.LSP.Core.csproj" />
    <ProjectReference Include="../Reqnroll.IdeSupport.VisualStudio.VsxStubs/Reqnroll.IdeSupport.VisualStudio.VsxStubs.csproj" />
  </ItemGroup>

  <!-- Microsoft.VisualStudio.TestWindow.Internal.dll (TestMethodIdentifier, public type) — same
       vswhere-resolved reference as Reqnroll.IdeSupport.VisualStudio.VSSDKIntegration.csproj (see its
       own comment for the full rationale). Needed here because RunTestCodeLensDataPointTests
       constructs real TestMethodIdentifier values to test the issue #700 invalidation-matching logic
       directly, rather than through a substituted/widened stand-in.
       Private=true (unlike VSSDKIntegration's own Private=false): that project ships inside a VSIX
       that always runs hosted in devenv.exe, where this assembly is already loaded — but `dotnet test`
       runs this project standalone, no devenv.exe host to supply it from, so it must be copied to the
       test output directory or every test in the process (not just ones touching this type) fails to
       load at run time. -->
  <Target Name="ResolveVsInstallDir" BeforeTargets="ResolveAssemblyReferences">
    <PropertyGroup>
      <VsWhereExe>$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe</VsWhereExe>
    </PropertyGroup>
    <Exec Command="&quot;$(VsWhereExe)&quot; -latest -property installationPath"
          Condition="Exists('$(VsWhereExe)')"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="VsInstallDir" />
    </Exec>
    <Warning Text="vswhere.exe not found or no VS install detected — Microsoft.VisualStudio.TestWindow.Internal reference will be skipped; RunTestCodeLensDataPointTests will fail to compile."
             Condition="'$(VsInstallDir)' == ''" />
    <ItemGroup Condition="'$(VsInstallDir)' != ''">
      <Reference Include="Microsoft.VisualStudio.TestWindow.Internal">
        <HintPath>$(VsInstallDir)\Common7\IDE\CommonExtensions\Microsoft\TestWindow\Microsoft.VisualStudio.TestWindow.Internal.dll</HintPath>
        <Private>true</Private>
      </Reference>
    </ItemGroup>
  </Target>
</Project>
